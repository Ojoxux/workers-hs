cabal-version: 3.0
name:          worker-app
version:       0.1.0.0
build-type:    Simple

executable worker-app
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , base
    , bytestring
    , http-types
    , text
    , wai
    , wai-handler-cloudflare

  default-language: Haskell2010
  ghc-options:
    -Wall -O2
    -- A wasm reactor module: the JavaScript runtime calls main once, then the
    -- request handler for every request.
    -no-hs-main
    -optl-mexec-model=reactor
