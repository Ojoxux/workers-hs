cabal-version:   3.0
name:            wai-handler-cloudflare
version:         0.1.0.0
synopsis:        Run a WAI Application on the Cloudflare Workers runtime
description:
  A WAI handler that bridges the Cloudflare Workers @fetch@ event to a WAI
  'Network.Wai.Application', in place of a socket-based server such as Warp.
  See docs/wai-support.md for the supported subset of WAI.

license:         BSD-3-Clause
license-file:    LICENSE
author:          Jou Okuyama
maintainer:      ojoxux@gmail.com
copyright:       2026 Jou Okuyama
category:        Web
homepage:        https://github.com/Ojoxux/workers-wai
bug-reports:     https://github.com/Ojoxux/workers-wai/issues
build-type:      Simple

library
  hs-source-dirs:   src
  exposed-modules:  Network.Wai.Handler.Cloudflare
  build-depends:
    , base             >=4.17 && <5
    , bytestring
    , cloudflare-workers
    , http-types
    , network
    , text
    , vault
    , wai

  default-language: Haskell2010
  ghc-options:      -Wall

source-repository head
  type:     git
  location: https://github.com/Ojoxux/workers-wai
  subdir:   haskell/wai-handler-cloudflare
