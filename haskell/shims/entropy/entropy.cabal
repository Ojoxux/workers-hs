cabal-version:   3.0
name:            entropy
version:         0.4.1.11
synopsis:        Real entropy for wasm32-wasi, backed by the host CSPRNG
description:
  The real `entropy` package does not build for wasm32-wasi: its custom
  @Setup.hs@ link-tests the target against @-lHSrts-1.0.3_thr@, and there is no
  threaded RTS for wasm.
  .
  This replacement is not a stub. WASI preview 1 offers @random_get@, and the
  browser\/Workers platform offers @crypto.getRandomValues@, which is a
  cryptographically secure PRNG. This package calls the latter through JSFFI,
  so 'System.Entropy.getEntropy' returns genuine cryptographic randomness.

license:         BSD-3-Clause
license-file:    LICENSE
author:          Jou Okuyama
maintainer:      ojoxux@gmail.com
copyright:       2026 Jou Okuyama
category:        Cryptography
homepage:        https://github.com/Ojoxux/workers-hs
bug-reports:     https://github.com/Ojoxux/workers-hs/issues
build-type:      Simple

library
  hs-source-dirs:   src
  exposed-modules:  System.Entropy
  build-depends:
    , base             >=4.17 && <5
    , bytestring
    , ghc-experimental

  default-language: Haskell2010
  ghc-options:      -Wall

source-repository head
  type:     git
  location: https://github.com/Ojoxux/workers-hs
  subdir:   haskell/shims/entropy
