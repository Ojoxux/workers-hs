cabal-version:   3.0
name:            network
version:         3.2.9.0
synopsis:        Socket-free stub of `network`, for wasm32-wasi
description:
  The real package cannot be built for wasm32-wasi: wasi-libc ships
  @sys/socket.h@ but no @netdb.h@, so `network`'s @HsNet.h@ fails to compile
  against undeclared @getaddrinfo@ / @getnameinfo@ / @freeaddrinfo@. Yet the
  whole WAI stack depends on it -- `wai` for @remoteHost :: SockAddr@, and
  `warp`, `http2`, `recv` and `streaming-commons` for real socket operations.
  `yesod-core` in turn depends on `warp` directly.
  .
  On Cloudflare Workers none of that code runs: the runtime owns the connection.
  This stub therefore provides real address types, which WAI genuinely uses, and
  socket operations that fail loudly with an explanation if anything ever calls
  them.
  .
  The version number matches the release this stands in for, so that
  dependency bounds resolve normally.

license:         BSD-3-Clause
license-file:    LICENSE
author:          Jou Okuyama
maintainer:      ojoxux@gmail.com
copyright:       2026 Jou Okuyama
category:        Network
homepage:        https://github.com/Ojoxux/workers-hs
bug-reports:     https://github.com/Ojoxux/workers-hs/issues
build-type:      Simple

library
  hs-source-dirs:   src
  exposed-modules:
    Network.Socket
    Network.Socket.ByteString

  build-depends:
    , base        >=4.17 && <5
    , bytestring
    , stm

  default-language: Haskell2010
  ghc-options:      -Wall

source-repository head
  type:     git
  location: https://github.com/Ojoxux/workers-hs
  subdir:   haskell/shims/network
